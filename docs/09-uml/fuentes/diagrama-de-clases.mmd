class AuthMiddleware { +authenticate(req,res,next)
  +requireRole(roles) Function
  -resolveUser(authorization) }
class LoginRateLimiter { -int maxFailures
  -int windowMs
  +handle(req,res,next)
  -record(key)
  -retryAfter(key, limit) int }
class ErrorMiddleware { +handle(error,req,res,next) }
class CorsPolicy { +fromEnv(env)$ CorsPolicy
  +isAllowed(origin) bool
  +toOptions() object }
class DatabaseSeeder { +DEFAULT_SERVICES$ object[]
  +run() }
AuthMiddleware --> TokenService
DatabaseSeeder --> PasswordHasher
DatabaseSeeder --> BookingLockService

class AppError { -int status
  +status() int
  +toJSON() object
  +from(error, message)$ AppError }
class ValidationError
class UnauthorizedError
class InvalidSessionError
class ForbiddenError
class NotFoundError
class ConflictError
class BookingError
class ServiceUnavailableError
class TooManyAttemptsError
AppError <|-- ValidationError
AppError <|-- UnauthorizedError
UnauthorizedError <|-- InvalidSessionError
AppError <|-- ForbiddenError
AppError <|-- NotFoundError
AppError <|-- ConflictError
ConflictError <|-- BookingError
AppError <|-- ServiceUnavailableError
