class AuthService { +RESET_TOKEN_TTL_MS$ int
  +register(data) Session
  +login(credentials) Session
  +getProfile(user)
  +updateProfile(user, data) Session
  +requestPasswordReset(email)
  +resetPassword(data)
  +toPublicUser(user)$
  -session(user) }
class UserService { +ROLES$ string[]
  +listAll()
  +create(data)
  +listStylists()
  +getSchedule(userId)
  +updateSchedule(userId, days)
  +update(id, data, currentUser)
  +delete(id, currentUser)
  -isValidWeek(days) bool }
class ServiceCatalogService {
  +listActive()
  +listAll()
  +create(data)
  +update(id, data)
  +delete(id)
  -hasUpcomingAppointments(name) bool }
class ServiceImageService { +MAX_BYTES$ int
  +URL_PREFIX$ string
  +detectType(bytes)$ string
  +urlFor(id)$ string
  +upload(bytes, name)
  +list()
  +get(id) }
class AppointmentService { +STATUSES$ string[]
  -int cancellationNoticeHours
  +getPolicy()
  +listFor(user)
  +create(user, data)
  +updateStatus(id, status, user)
  +update(id, data, user)
  +reschedule(id, data, user)
  +delete(id)
  -change(options)
  -assertCanChange(appointment, changes, user)
  -assertCanComplete(appointment)
  -assertCanMarkNoShow(appointment)
  -assertCancellationNotice(appointment)
  -notify(appointment, message) }
class AvailabilityService { +OCCUPYING_STATUSES$ string[]
  +DEFAULT_DURATION$ int
  +getAvailability(date, stylist)
  +assertSlotAvailable(slot)
  -workdayOf(stylist, weekday)
  -overlaps(a, b) bool }
class TimeOffService { +MAX_DAYS$ int
  +list(user)
  +create(user, data)
  +delete(id, user)
  +findBlocking(date, stylist, session)
  +describe(block)$ string }
class ReminderService { +INTERVAL_MS$ int
  +sendDueReminders()
  +start(intervalMs)
  +stop()
  -send(appointment) }
class ReviewService { +MAX_COMMENT$ int
  +shortName(fullName)$ string
  +create(user, data)
  +listPublic(filters)
  +summary()
  +reviewedAppointmentIds(user)
  +listAll()
  +delete(id) }
class ClientNoteService { +MAX_LENGTH$ int
  +list(user, client)
  +create(user, client, data)
  +delete(id, user)
  -assertAccess(user, client) }
class BookingLockService { +initialize()
  +lock(session, stylists) }
class EmailService { +isConfigured() bool
  +send(message)
  +sendBestEffort(message) }
class TokenService { -string secret
  +sign(user) string
  +verify(token) object }
class PasswordHasher { -int rounds
  +hash(password) string
  +compare(password, hash) bool }
class BogotaClock { +today() string
  +minutesNow() int }

