%% Imagen: docs/10-logica-de-datos/Diagrama de colecciones.png
%% Generar: npx -p @mermaid-js/mermaid-cli mmdc -c docs/mermaid-config.json -i "docs/10-logica-de-datos/diagrama-de-colecciones.mmd" -o "docs/10-logica-de-datos/Diagrama de colecciones.png" -s 2 -b white
erDiagram
  USER ||--o{ APPOINTMENT : "reserva (username)"
  USER ||--o{ APPOINTMENT : "atiende (stylist)"
  SERVICE ||--o{ APPOINTMENT : "se copia (nombre, duración, precio)"
  APPOINTMENT ||--o| REVIEW : "se califica (appointment)"
  USER ||--o{ TIME_OFF : "bloquea agenda (stylist)"
  USER ||--o{ CLIENT_NOTE : "es descrito (client)"
  USER ||--o{ CLIENT_NOTE : "escribe (author)"
  SERVICE_IMAGE ||--o{ SERVICE : "ilustra (image = URL)"
  SERVICE_IMAGE ||--o{ HERO_SLIDE : "fondo de la portada (image = URL)"
  USER {
    ObjectId _id PK
    string username UK "minúsculas"
    string password "hash bcrypt; vacío si entra solo con Google"
    string googleId UK "sub de Google; opcional"
    string fullName
    string email UK
    string phoneNumber
    enum role "ADMIN | CLIENT | STYLIST"
    bool isActive
    array weeklySchedule "day, enabled, start, end (HH:mm)"
    int bookingLockVersion "candado de reservas del estilista"
    int tokenVersion
    string passwordResetTokenHash
    date passwordResetExpiresAt
  }
  HERO_SLIDE {
    ObjectId _id PK
    string image "/images/... o /api/service-images/:id"
    string alt "texto alternativo; máx. 140"
    int position "orden en el carrusel"
    bool isActive
  }
  SERVICE {
    ObjectId _id PK
    string name
    string description
    string price
    int duration "15 a 480 min"
    string image
    bool isActive
  }
  APPOINTMENT {
    ObjectId _id PK
    string username FK
    string service
    int duration
    string price
    string stylist FK "vacío = sin estilista"
    string date "YYYY-MM-DD"
    string time "h:mm AM/PM"
    string notes
    enum status "PENDING | CONFIRMED | CANCELLED | COMPLETED | NO_SHOW"
    date reminderSentAt
  }
  REVIEW {
    ObjectId _id PK
    ObjectId appointment FK,UK
    string username
    string authorName
    string service
    string stylist
    int rating "1 a 5"
    string comment "máx. 500"
  }
  TIME_OFF {
    ObjectId _id PK
    string stylist FK "vacío = cierre del spa"
    string start "YYYY-MM-DD"
    string end "YYYY-MM-DD"
    string reason "máx. 120"
    string createdBy
  }
  CLIENT_NOTE {
    ObjectId _id PK
    string client FK
    string author FK
    string authorName
    string text "máx. 1000"
  }
  SERVICE_IMAGE {
    ObjectId _id PK
    binary data
    enum contentType "jpeg | png | webp"
    int size "máx. 5 MB"
    string name
  }
  BOOKING_LOCK {
    string _id PK "unassigned: citas sin estilista"
    int version
  }
