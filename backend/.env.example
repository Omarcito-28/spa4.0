# En Render no se define: la plataforma asigna el puerto en PORT.
PORT=5000
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/<base>?retryWrites=true&w=majority
JWT_SECRET=<secreto-aleatorio-de-al-menos-32-caracteres>

# URL pública del frontend, sin "/" al final. Se usa en los enlaces de recuperación de
# contraseña y es el origen que CORS acepta. En Vercel: https://<tu-proyecto>.vercel.app
# Si NODE_ENV=production es obligatoria.
FRONTEND_URL=http://localhost:5173
# Opcional: otros orígenes permitidos por CORS, separados por comas (por ejemplo un dominio propio).
CORS_ORIGINS=
# En producción: NODE_ENV=production
NODE_ENV=

# Solo para una base de datos que todavía no tiene administrador.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# SMTP es obligatorio para la recuperación de contraseña y los avisos de citas por correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
